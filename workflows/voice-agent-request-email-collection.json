      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE email_collection_schema.requests SET sms_sid=NULLIF($2,''),sms_status=$3,status=CASE WHEN status<>'sending' THEN status WHEN NULLIF($2,'') IS NOT NULL AND $3 NOT IN ('failed','undelivered','canceled') THEN 'pending' ELSE 'send_unknown' END WHERE id=$1::uuid RETURNING jsonb_build_object('status',status,'messageSent',sms_sid IS NOT NULL AND sms_status NOT IN ('failed','undelivered','canceled'),'request_id',id) AS result;",
        "options": {
          "queryReplacement": "={{ [$('Collection result').first().json.request_id,$json.sid??'', $json.status??'unknown'] }}"
        }
