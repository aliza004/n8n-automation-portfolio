      "parameters": {
        "jsCode": "const m=$json.body?.message??{};\nconst calls=m.toolCallList??m.toolCalls??m.toolWithToolCallList?.map(x=>x.toolCall)??[];\nconst tc=calls[0]??{};\nconst number=(v)=>typeof v==='string'?v.trim():'';\nconst caller=number(m.artifact?.variables?.customer?.number||m.call?.customer?.number||m.customer?.number);\nconst agents=[m.phoneNumber?.number,m.call?.phoneNumber?.number,m.artifact?.variables?.phoneNumber?.number].filter(Boolean).map(number);\nconst agent=agents[0]??'';\nconst alt=[m.call?.customer?.number,m.customer?.number].filter(Boolean).map(number);\nconst valid=m.type==='tool-calls'&&calls.length===1&&tc.function?.name==='_requestEmailCollection_orch'&&!!tc.id&&!!m.call?.id&&/^\\+[1-9]\\d{7,14}$/.test(caller)&&/^\\+[1-9]\\d{7,14}$/.test(agent)&&alt.every(x=>x===caller)&&agents.every(x=>x===agent);\nreturn [{json:{valid,callerPhone:caller,agent,call_id:m.call?.id??'',tool_call_id:tc.id??'',status:'invalid_call_context',messageSent:false}}];"
      }
    },
