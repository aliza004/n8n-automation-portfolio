    {
      "id": "bdd92785-f01c-e722-a902-af89e1f56b3b",
      "name": "Evaluate Policy",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -5376,
        1312
      ],
      "parameters": {
        "jsCode": "const contact = $input.first().json;\nconst blockers = contact.blockers || [];\nif (blockers.length > 0) return [{ json: { action: 'block', policy: 'blocked', reason: blockers.join(', ') } }];\nconst policy = contact.contact_id ? (contact.sms_send_policy || 'approval_required') : 'approval_required';\nif (policy === 'blocked') return [{ json: { action: 'block', policy, reason: 'Contact sms_send_policy is blocked' } }];\nif (policy === 'autonomous_allowed') return [{ json: { action: 'send', policy } }];\nreturn [{ json: { action: 'pending', policy } }];"
      }
    },
