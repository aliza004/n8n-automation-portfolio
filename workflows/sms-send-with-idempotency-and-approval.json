      "id": "e75a00be-d8f7-e48c-0a5f-f4d745a889bd",
      "name": "Prepare Twilio Transport",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -4592,
        1008
      ],
      "parameters": {
        "jsCode": "const c=$json.credential;\nif(!c||!/^AC[0-9a-f]{32}$/i.test(c.account_sid||'')||!/^SK[0-9a-f]{32}$/i.test(c.api_key_sid||'')||typeof c.api_key_secret!=='string'||!c.api_key_secret.length||c.api_key_secret.length>512)throw new Error('TWILIO_CREDENTIAL_INVALID');\nreturn [{json:{account_sid:c.account_sid,authorization:'Basic '+Buffer.from(c.api_key_sid+':'+c.api_key_secret,'utf8').toString('base64')}}];"
      }
    },
