      ],
      "parameters": {
        "jsCode": "const usernames = items\n  .map(item => item.json.userName)\n  .filter(username => typeof username === 'string');\n\nreturn [\n  {\n    json: {\n      existingUsernames: usernames.join(', ')\n    }\n  }\n];"
      }
    },
    {
      "id": "4412225f-e5b3-2664-3b8c-2e1d9b7b10ae",
      "name": "AI Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.8,
      "position": [
        -2560,
        528
      ],
      "parameters": {
        "promptType": "define",
        "text": "=You are generating a new user entry for a form.\n\nRules:\n1. Username must start with \"usr\" followed by a 4-digit number, starting from **usr1000** onward (e.g., usr1000, usr1001...).\n2. Do **NOT** use any username that already exists in this list: {{ $json.existingUsernames }}\n3. Email must be in the format: <username>@example.com\n4. Name should be identical to the username.\n5. Password must be 8 to 12 characters long and a secure mix of uppercase and lowercase letters (only text).\n6. Use today’s date from `{{ $now }}` formatted as \"07/17/2025\".\n\nReturn output in JSON format only:\n\n```json\n{\n  \"username\": \"...\",\n  \"email\": \"...\",\n  \"name\": \"...\",\n  \"password\": \"...\",\n  \"date\": \"07/17/2025\"\n}\n```",
        "hasOutputParser": true,
        "options": {}
