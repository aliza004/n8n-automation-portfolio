    {
      "id": "2e5fb75a-06a9-cd27-d6fd-766231684b0f",
      "name": "Extract Tokens1",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [
        -1888,
        560
      ],
      "parameters": {
        "functionCode": "const cookieHeader = $input.first().json.headers['set-cookie'];\n\nif (!cookieHeader) {\n  throw new Error('No set-cookie header found');\n}\n\nconst xsrf = cookieHeader.find(c => c.includes('XSRF-TOKEN'));\nconst xsrfToken = xsrf.split(';')[0];\nconst xsrfTokenValue = decodeURIComponent(xsrfToken.split('=')[1]);\n\nconst session = cookieHeader.find(c => c.includes('app_session'));\nconst sessionCookie = session.split(';')[0];\n\nreturn [{\n  xsrfToken,\n  xsrfTokenValue,\n  sessionCookie\n}];"
      }
    },
