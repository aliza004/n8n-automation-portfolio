    {
      "id": "69e99f42-8f4f-c504-047b-d0159b1c8af5",
      "name": "Extract Session Cookie1",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [
        -1424,
        560
      ],
      "parameters": {
        "functionCode": "const response = $input.first().json;\nconst cookieHeader = response.headers['set-cookie'];\n\nif (!cookieHeader) {\n  throw new Error('No cookies found');\n}\n\n// Extract XSRF token\nconst xsrfCookie = cookieHeader.find(c => c.includes('XSRF-TOKEN'));\nif (!xsrfCookie) {\n  throw new Error('XSRF token not found');\n}\n\nconst xsrfToken = xsrfCookie.split(';')[0];\nconst xsrfValue = decodeURIComponent(xsrfToken.split('=')[1]);\n\n// Extract session\nconst sessionCookie = cookieHeader.find(c => c.includes('app_session'));\nif (!sessionCookie) {\n  throw new Error('Session cookie not found');\n}\n\nconst session = sessionCookie.split(';')[0];\n\nreturn [{\n  xsrfToken: xsrfToken,\n  xsrfValue: xsrfValue,\n  sessionCookie: session\n}];"
      }
    },
